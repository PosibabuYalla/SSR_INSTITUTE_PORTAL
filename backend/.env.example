# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replica set required — transactions are used)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssr-portal

# JWT / sessions
# JWT_SECRET: 32+ random characters (the server refuses to start outside development otherwise).
JWT_SECRET=replace-with-a-long-random-secret
# Access tokens are short-lived and held only in browser memory; the refresh-token session
# (httpOnly cookie, rotated on every use, revocable) keeps users signed in.
JWT_EXPIRES_IN=15m
SESSION_TTL_DAYS=30
# Refresh cookie SameSite: lax (frontend and API on the same site) or none (different sites,
# e.g. *.vercel.app + *.railway.app; forces Secure/HTTPS).
COOKIE_SAMESITE=lax

# Seeding: required by `npm run seed` (12+ chars, upper, lower, digit). No default exists.
SEED_PASSWORD=

# Token / OTP expiry
RESET_TOKEN_EXPIRES_MINUTES=30
OTP_EXPIRES_MINUTES=10

# Canonical frontend origin (no trailing slash) — used both for CORS and for building absolute
# links (e.g. password-reset emails). In development, localhost:3000 and localhost:5173 are
# ALWAYS allowed by CORS in addition to this value, so it doesn't matter which dev port you use.
# In production this must be set explicitly (the server refuses to start without it) to your
# real deployed frontend, e.g. CLIENT_URL=https://ssr-institute-portal.vercel.app — and set
# COOKIE_SAMESITE=none above, since a Vercel + Render deployment is cross-site.
CLIENT_URL=http://localhost:3000

# Email — leave blank in dev to log emails to console instead of sending
EMAIL_FROM=no-reply@ssrinstitute.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudinary — required for file uploads (materials, task submissions)
# Get these from https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
